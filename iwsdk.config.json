{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/main.iwsdk.scene.json",
  "assets": {
    "module": "./src/assets"
  },
  "components": {
    "module": "./src/components"
  },
  "world": {
    "xr": {
      "mode": "ar",
      "offer": "always",
      "features": {
        "handTracking": true,
        "gazeTracking": { "required": false },
        "anchors": { "required": false },
        "planeDetection": { "required": false },
        "hitTest": { "required": false },
        "meshDetection": { "required": false }
      }
    },
    "input": {
      "canvasPointerEvents": true
    },
    "render": {
      "fov": 60,
      "near": 0.01,
      "far": 50,
      "camera": {
        "position": [0, 1.4, 0.6],
        "lookAt": [0, 1.25, -0.9]
      }
    },
    "features": {
      "locomotion": false,
      "grabbing": true,
      "physics": false,
      "sceneUnderstanding": false,
      "environmentRaycast": false,
      "gaze": { "suppressWhenDirectPointerActive": true, "showDebugReticle": false }
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3",
      "iwer": true,
      "activation": "always",
      "injectOnBuild": true,
      "environment": "sunlit_living_room"
    },
    "targetDevicePreview": { "gazeSimulation": "head" }
  }
}
